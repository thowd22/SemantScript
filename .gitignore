node_modules/
dist/
.cache/
coverage/
*.log
*.ses
*.tsbuildinfo

.venv/
.python-packages/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/

.env
.env.*
!.env.example

/artifacts/
/checkpoints/
/runs/

.DS_Store

# downloaded installers (Ollama bundles live in trainer/ during setup)
*.tar.zst
*.tar.gz

# dataset cache lock files are runtime state, never data
benchmarks/refund/data/**/*.lock

# exported release artifacts are content-addressed ONNX bundles (hundreds of MB); the
# pipeline manifest, verification record and ledger bind them by digest
benchmarks/refund/data/release-*/artifact/

# extracted or converted encoder checkpoints used by the encoder sweep (hundreds of MB)
benchmarks/refund/data/encoders/

# compiled typed-decisions programs and their dataset caches are rebuilt from the pinned dataset
benchmarks/typed-decisions/program/dist/
benchmarks/typed-decisions/data/cache/

# example applications are standalone packages; their installs and build outputs are not tracked
examples/*/node_modules/
examples/*/dist/
examples/*/.next/
examples/*/package-lock.json
examples/next-app/semantscript.ir.v1.json
examples/*/.semantscript/
