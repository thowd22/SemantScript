{
  "name": "semantscript",
  "version": "0.1.0",
  "description": "The semantscript command: init, build, train, test, run, explain and releases",
  "keywords": [
    "semantscript",
    "sema",
    "typescript",
    "classifier",
    "cli"
  ],
  "homepage": "https://github.com/thowd22/SemantScript/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/thowd22/SemantScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thowd22/SemantScript.git",
    "directory": "cli"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "semantscript": "./bin/semantscript.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@semantscript/compiler": "0.1.0",
    "@semantscript/core": "0.1.0"
  },
  "peerDependencies": {
    "typescript": ">=5.9.0 <7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
