{
  "name": "@semantscript/compiler",
  "version": "0.1.0",
  "description": "The SemantScript compiler: finds sema expressions in TypeScript, emits their IR and rewrites them to runtime calls",
  "keywords": [
    "semantscript",
    "sema",
    "typescript",
    "classifier",
    "compiler",
    "typescript-transformer",
    "vite-plugin",
    "esbuild-plugin"
  ],
  "homepage": "https://github.com/thowd22/SemantScript/tree/main/compiler#readme",
  "bugs": {
    "url": "https://github.com/thowd22/SemantScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thowd22/SemantScript.git",
    "directory": "compiler"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "ts-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transformer": {
      "types": "./dist/transformer.d.ts",
      "default": "./dist/transformer.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./ts-plugin": {
      "types": "./dist/ts-plugin.d.cts",
      "default": "./ts-plugin/index.js"
    }
  },
  "peerDependencies": {
    "typescript": ">=5.9.0 <7.0.0",
    "esbuild": ">=0.20.0",
    "vite": ">=5.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
