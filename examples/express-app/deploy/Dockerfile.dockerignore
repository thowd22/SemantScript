!package-lock.json
!tsconfig.base.json
!tsconfig.json
!cli/package.json
!benchmarks/refund/package.json
!compiler
!runtime
!framework
!examples/express-app
**/node_modules
**/dist
**/.cache
compiler/test
runtime/test
framework/test
examples/express-app/.semantscript
!examples/express-app/.semantscript/artifact
