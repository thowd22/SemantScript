{
  "name": "@semantscript/framework",
  "version": "0.1.0",
  "description": "Controller-style handlers with sema expressions, mounted on Express, Fastify, Next.js or Node http",
  "keywords": [
    "semantscript",
    "sema",
    "typescript",
    "classifier",
    "framework",
    "express",
    "fastify",
    "nextjs"
  ],
  "homepage": "https://github.com/thowd22/SemantScript/tree/main/framework#readme",
  "bugs": {
    "url": "https://github.com/thowd22/SemantScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thowd22/SemantScript.git",
    "directory": "framework"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@semantscript/core": "0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "5.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
