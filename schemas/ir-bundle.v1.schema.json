{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantscript.dev/schemas/ir-bundle.v1.schema.json",
  "title": "SemantScript IR Bundle v1",
  "description": "Versioned source neural-function records and their deterministic data-dependency execution plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "bundleVersion", "functions", "executionPlan"],
  "properties": {
    "kind": {
      "const": "semantscript.ir-bundle"
    },
    "bundleVersion": {
      "const": 1
    },
    "functions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantscript.dev/schemas/neural-function.v1.schema.json"
          },
          {
            "type": "object",
            "properties": {
              "stage": {
                "const": "source"
              }
            }
          }
        ]
      }
    },
    "executionPlan": {
      "$ref": "#/$defs/executionPlan"
    }
  },
  "$defs": {
    "functionId": {
      "type": "string",
      "pattern": "^nf_[a-f0-9]{64}$"
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "dependencies"],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionStage"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "executionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "functionIds"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "functionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/functionId"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerFunctionId", "consumerFunctionId", "consumerInput"],
      "properties": {
        "producerFunctionId": {
          "$ref": "#/$defs/functionId"
        },
        "consumerFunctionId": {
          "$ref": "#/$defs/functionId"
        },
        "consumerInput": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    }
  }
}
