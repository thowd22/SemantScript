{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantscript.dev/schemas/refund-benchmark-dataset.v1.schema.json",
  "title": "SemantScript refund held-out benchmark dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "datasetVersion",
    "benchmark",
    "split",
    "createdAt",
    "function",
    "support",
    "cases",
    "humanAttestation",
    "payloadSha256"
  ],
  "properties": {
    "kind": { "const": "semantscript.refund-benchmark-dataset" },
    "datasetVersion": { "const": 1 },
    "benchmark": { "const": "refund-decision" },
    "split": { "const": "evaluation-only" },
    "createdAt": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/timestamp"
    },
    "function": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/functionBinding"
    },
    "support": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/refundSupport"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/refundCase"
      }
    },
    "humanAttestation": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/humanAttestation"
    },
    "payloadSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    }
  }
}
