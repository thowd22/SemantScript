{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantscript.dev/schemas/refund-benchmark-predictions.v1.schema.json",
  "title": "SemantScript refund benchmark predictions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "predictionVersion",
    "benchmark",
    "datasetSha256",
    "support",
    "system",
    "environment",
    "protocol",
    "predictions",
    "payloadSha256"
  ],
  "properties": {
    "kind": { "const": "semantscript.refund-benchmark-predictions" },
    "predictionVersion": { "const": 1 },
    "benchmark": { "const": "refund-decision" },
    "datasetSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    },
    "support": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/refundSupport"
    },
    "system": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/systemProvenance"
    },
    "environment": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/environmentProvenance"
    },
    "protocol": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/measurementProtocol"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/prediction"
      }
    },
    "payloadSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    }
  }
}
