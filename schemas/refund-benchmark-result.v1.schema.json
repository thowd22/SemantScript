{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantscript.dev/schemas/refund-benchmark-result.v1.schema.json",
  "title": "SemantScript refund benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "resultVersion",
    "benchmark",
    "generatedAt",
    "taskSpecSha256",
    "datasetSha256",
    "trainingLedgerSha256",
    "leakageAudit",
    "systems",
    "goNoGo",
    "payloadSha256"
  ],
  "properties": {
    "kind": { "const": "semantscript.refund-benchmark-result" },
    "resultVersion": { "const": 1 },
    "benchmark": { "const": "refund-decision" },
    "generatedAt": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/timestamp"
    },
    "taskSpecSha256": {
      "const": "ffc5c59463a4a9f0cf38e0f6d44d09b1df0e91f13bb9c87a73b049f20c35014c"
    },
    "datasetSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    },
    "trainingLedgerSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    },
    "leakageAudit": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/leakageAudit"
    },
    "systems": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/systemResult"
      }
    },
    "goNoGo": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/goNoGo"
    },
    "payloadSha256": {
      "$ref": "https://semantscript.dev/schemas/refund-benchmark-common.v1.schema.json#/$defs/sha256"
    }
  }
}
